{
  "version": 2,
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "data/synthetic_fault_dataset.csv,data/fault_detection_results.csv,data/final_complete_test_diagnostics.csv,Backend/**,src/**",
      "excludeFiles": "frontend/**,notebooks/**,.conda/**,.venv/**,scratch/**,evaluation_results/**,data/anomaly_results*.csv,data/merged_fault_anomaly_dataset.csv,data/engineered_weather.csv"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/stats", "destination": "/api/index.py" },
    { "source": "/analysis/run", "destination": "/api/index.py" },
    { "source": "/data/upload", "destination": "/api/index.py" },
    { "source": "/anomaly/results", "destination": "/api/index.py" },
    { "source": "/classification/results", "destination": "/api/index.py" },
    { "source": "/results", "destination": "/api/index.py" },
    { "source": "/scenarios", "destination": "/api/index.py" },
    { "source": "/scenarios/(.*)", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
